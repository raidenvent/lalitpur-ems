# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string, e.g.:
#   postgres://user:password@localhost:5432/lmc_ems
DATABASE_URL=postgres://lmc_ems:lmc_ems@localhost:5432/lmc_ems

# Set to "false" only for local Postgres without SSL. Leave default for
# managed hosts (Render/Railway/RDS) which require SSL.
PGSSL=false

# Long random string — e.g. `openssl rand -hex 32`. Required, no default.
JWT_SECRET=

PORT=4000

# Comma-separated list of allowed frontend origins, e.g.
#   https://ems.lalitpurmc.gov.np,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Used to build the QR pointer URL (§15). Must be the real public URL of
# the deployed frontend in production.
PUBLIC_APP_URL=https://lmc-ems.example.gov.np

NODE_ENV=development
