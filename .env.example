# Vite development / Cloudflare Quick Tunnel
VITE_API_PROXY=http://localhost:4000
# For a named tunnel, set this to the public hostname, e.g. ems.example.com
# VITE_ALLOWED_HOST=ems.example.com
# If VITE_API_URL is set, the browser will call that URL directly instead of /api.
# Leave unset to use the Vite /api proxy.
